<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Normal permission: lets a swipe gesture pull down the notification panel. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- Only used if the person turns reminders on. The Android 13+ prompt is shown at that moment, never at first launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Only used if the person turns on fingerprint / face for the hidden-apps list. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- See launchable apps without the broad QUERY_ALL_PACKAGES permission -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Icon packs (ADW / Nova / Apex / GO style) -->
        <intent><action android:name="org.adw.launcher.THEMES" /></intent>
        <intent><action android:name="com.novalauncher.THEME" /></intent>
        <intent><action android:name="com.anddoes.launcher.THEME" /></intent>
        <intent><action android:name="com.gau.go.launcherex.theme" /></intent>
        <!-- Apps that offer widgets, so their names show in the widget picker -->
        <intent><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent>
    </queries>

    <application
        android:name=".ElevateApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Elevate">

        <!-- Works as a normal app (LAUNCHER) and as the default Home screen (HOME). -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Elevate">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Elevate" />

        <activity
            android:name=".center.ui.CenterActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Elevate"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".privacy.CalculatorActivity"
            android:exported="false"
            android:excludeFromRecents="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Elevate" />

        <!-- A separate "Calculator" icon. Off by default; switched on from Hidden apps and privacy. -->
        <activity-alias
            android:name=".CalculatorAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_calculator"
            android:label="@string/calculator_label"
            android:roundIcon="@drawable/ic_calculator"
            android:targetActivity=".privacy.CalculatorActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".privacy.HiddenAppsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Elevate" />

        <activity
            android:name=".privacy.PrivacyActivity"
            android:exported="false"
            android:theme="@style/Theme.Elevate" />

        <!-- Lets the camera app write one temporary picture for the Photo journal. Nothing else is shared. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Elevate's own widget: habits done today and the workout plan. Only active if someone adds it. -->
        <receiver
            android:name=".widgets.TodayWidget"
            android:exported="true"
            android:label="@string/widget_today_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <activity
            android:name=".gaming.GamingActivity"
            android:exported="false"
            android:theme="@style/Theme.Elevate" />

        <receiver
            android:name=".gaming.GamingReceiver"
            android:exported="false" />

        <!-- Quick Settings tile: Gaming mode on/off -->
        <service
            android:name=".gaming.GamingTile"
            android:exported="true"
            android:icon="@drawable/ic_notif"
            android:label="@string/gaming_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Only for the Lock screen gesture. Off until the person turns it on in Accessibility settings. -->
        <service
            android:name=".gestures.LockService"
            android:exported="true"
            android:label="@string/lock_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lock_service" />
        </service>

        <activity
            android:name=".backup.BackupActivity"
            android:exported="false"
            android:theme="@style/Theme.Elevate" />

        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.Elevate" />

        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminders.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
